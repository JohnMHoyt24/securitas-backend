application-local.properties
application-*.local.properties
!.mvn/wrapper/maven-wrapper.properties
!src/main/resources/**/*.properties

### SQL files ###
# Only ignore ad-hoc scratch SQL, never Flyway migrations.
!src/main/resources/db/migration/*.sql
